{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@plannotator/opencode@latest",
    // [
    //   "oc-plugin-vault-tec",
    //   {
    //     "enabled": false,
    //     "mode": "append"
    //   }
    // ]
  ],
  "small_model": "openai/gpt-5.6-luna-fast",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "textVerbosity": "low"
          }
        }
      }
    }
  },
  "lsp": false,
  "references": {
    "effect-src": {
      "repository": "Effect-TS/effect",
      "description": "Use when reading, writing or reviewing Effect-ts code"
    },
    "better-result-src": {
      "repository": "dmmulroy/better-result",
      "description": "Use when reading, writing or reviewing better-result code"
    },
    "opencode-src": {
      "repository": "anomalyco/opencode",
      "description": "Use when you need good examples of architecture, design, patterns, practices and style guide in Typescript/Effect repos"
    },
    "pi-src": {
      "repository": "earendil-works/pi",
      "description": "Use when you need good examples of architecture, design, patterns, practices and style guide in Typescript repos"
    },
    "codexbar-src": {
      "repository": "steipete/CodexBar",
      "description": "Use for Swift 6, Observation, menu-bar AppKit/SwiftUI integration, provider adapters, transport security, and Swift Testing; do not copy its central store/controller topology"
    },
    "aerospace-src": {
      "repository": "nikitabobko/AeroSpace",
      "description": "Use for Swift 6 systems code, Accessibility thread confinement, typed command and config parsers, fixture-driven tests, and macOS 13 interop; do not copy its global-state or mutable-tree architecture"
    },
    "ghostty-src": {
      "repository": "ghostty-org/ghostty",
      "description": "Use for referencing high quality Zig code, project architecture, design, style guide, patterns and practices."
    }
  },
  "permission": {
    "websearch": "allow",
    "question": "allow",
    "external_directory": {
      "~/.local/share/agent-skills/personal-drafting/**": "allow"
    },
    "skill": {
      "*": "allow",
      "personal-drafting": "deny",
      "principle-subtract-before-you-add": "deny"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "skill": {
          "personal-drafting": "allow"
        }
      }
    },
    "explore": {
      "mode": "subagent",
      "description": "Focused codebase search specialist",
      "model": "openai/gpt-5.6-luna-fast",
      "variant": "xhigh"
    },
    "librarian": {
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra-fast",
      "variant": "high",
      "description": "External docs and examples specialist",
      "prompt": "{file:./prompts/librarian-harness.md}"
    },
    "oracle": {
      "mode": "subagent",
      "description": "Strategic consultation specialist",
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "prompt": "{file:./prompts/oracle-harness.md}"
    },
    "general": {
      "model": "openai/gpt-5.6-sol-fast",
      "variant": "high"
    }
  },
  "mcp": {
    "executor": {
      "type": "remote",
      "url": "http://127.0.0.1:4789/mcp",
      "enabled": true,
      "timeout": 30000,
      "headers": {
        "Authorization": "{env:EXECUTOR_MCP_AUTHORIZATION}"
      }
    },
    // "notion": {
    //   "type": "remote",
    //   "url": "https://mcp.notion.com/mcp"
    // },
    // "linear": {
    //   "type": "remote",
    //   "url": "https://mcp.linear.app/mcp",
    //   "enabled": true
    // },
    "slack": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "slack-mcp-server@latest",
        "--transport",
        "stdio"
      ],
      "environment": {
        "SLACK_MCP_ENABLED_TOOLS": "channels_list,conversations_history,conversations_replies,conversations_search_messages,usergroups_list,usergroups_me",
        "SLACK_MCP_XOXP_TOKEN": "{env:SLACK_MCP_XOXP_TOKEN}",
        "SLACK_MCP_XOXB_TOKEN": "{env:SLACK_MCP_XOXB_TOKEN}",
        "SLACK_MCP_XOXC_TOKEN": "{env:SLACK_MCP_XOXC_TOKEN}",
        "SLACK_MCP_XOXD_TOKEN": "{env:SLACK_MCP_XOXD_TOKEN}"
      }
    }
  }
}
