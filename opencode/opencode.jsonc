{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@plannotator/opencode@latest"
  ],
  "references": {
    "effect-src": {
      "repository": "Effect-TS/effect",
      "description": "Use when reading, writing or reviewing Effect-ts code"
    },
    "better-result-src": {
      "repository": "dmmulroy/better-result",
      "description": "Use when reading, writing or reviewing better-result code"
    },
    "opencode-src": {
      "repository": "anomalyco/opencode",
      "description": "Use when you need good examples of architecture, design, patterns, practices and style guide in Typescript/Effect repos"
    },
    "pi-src": {
      "repository": "earendil-works/pi",
      "description": "Use when you need good examples of architecture, design, patterns, practices and style guide in Typescript repos"
    },
    "codexbar-src": {
      "repository": "steipete/CodexBar",
      "description": "Use for Swift 6, Observation, menu-bar AppKit/SwiftUI integration, provider adapters, transport security, and Swift Testing; do not copy its central store/controller topology"
    },
    "aerospace-src": {
      "repository": "nikitabobko/AeroSpace",
      "description": "Use for Swift 6 systems code, Accessibility thread confinement, typed command and config parsers, fixture-driven tests, and macOS 13 interop; do not copy its global-state or mutable-tree architecture"
    },
    "ghostty-src": {
      "repository": "ghostty-org/ghostty",
      "description": "Use for referencing high quality Zig code, project architecture, design, style guide, patterns and practices."
    }
  },
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/agent-skills/personal-drafting/*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "personal-drafting", "effect": "deny" },
    { "action": "skill", "resource": "principle-subtract-before-you-add", "effect": "deny" }
  ],
  "agents": {
    "title": {
      "model": "openai/gpt-5.6-luna-fast"
    },
    "build": {
      "permissions": [
        { "action": "skill", "resource": "personal-drafting", "effect": "allow" }
      ]
    },
    "explore": {
      "mode": "subagent",
      "description": "Read-only local codebase evidence gathering: locate files, trace existing behavior, and return interfaces, tests, constraints, and unresolved decisions to the primary.",
      "model": "openai/gpt-6-luna-fast#xhigh",
      "system": "{file:./prompts/explore-harness.md}"
    },
    "librarian": {
      "mode": "subagent",
      "description": "Read-only external research: retrieve current documentation, upstream source, API contracts, and version-specific examples, then return evidence and unresolved decisions to the primary.",
      "model": "openai/gpt-6-luna-fast#max",
      "system": "{file:./prompts/librarian-harness.md}"
    },
    "oracle": {
      "mode": "subagent",
      "description": "Read-only second opinion on consequential unresolved engineering decisions. The primary retains decisions, authority, implementation, and verification.",
      "model": "openai/gpt-6-astra#medium",
      "system": "{file:./prompts/oracle-harness.md}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "executor_*", "resource": "*", "effect": "deny" }
      ]
    },
    "general": {
      "description": "Implement and verify bounded engineering tasks, including multi-file changes and tests. Use explore for factual reconnaissance and return consequential unresolved decisions to the primary.",
      "model": "openai/gpt-6-sol#high"
    }
  },
  "mcp": {
    "servers": {
      "executor": {
        "type": "local",
        "command": [
          "/Applications/Executor.app/Contents/Resources/executor/executor",
          "mcp"
        ]
      }
    }
  }
}
