diff --git a/lib/scripts/refresh-widget.sh b/lib/scripts/refresh-widget.sh
new file mode 100755
index 0000000..8238e54
--- /dev/null
+++ b/lib/scripts/refresh-widget.sh
@@ -0,0 +1,17 @@
+#!/bin/sh
+
+LOCK_DIR="${TMPDIR:-/tmp}/simple-bar-refresh-widget.lock"
+
+if ! mkdir "$LOCK_DIR" 2>/dev/null; then
+  exit 0
+fi
+
+cleanup() {
+  rmdir "$LOCK_DIR" 2>/dev/null || true
+}
+trap cleanup EXIT INT TERM
+
+osascript \
+  -e 'with timeout of 2 seconds' \
+  -e 'tell application id "tracesOf.Uebersicht" to refresh widget id "simple-bar-index-jsx"' \
+  -e 'end timeout'
